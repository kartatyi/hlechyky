# Скопіюй у liquidsoap/.env (або запусти setup.ps1 з кореня, він зробить це сам і згенерує ключ).
# liquidsoap живе в tools\liquidsoap і стартує з start.ps1, який читає цей файл.
# Куди liquidsoap стукає, коли міняється трек (сервер Hlechyky). Ключ має збігатися з Liquidsoap:ApiKey в appsettings.Local.json.
RT_API_URL=http://127.0.0.1:8080
RT_API_KEY=<LiquidsoapApiKey>
# Потік: http://127.0.0.1:HARBOR_PORT/radio.mp3 (на проді Caddy віддає його на https://…/radio.mp3 і на :8000).
HARBOR_PORT=8001
# Керування ефіром; має збігатися з Liquidsoap:Port в appsettings.Local.json.
TELNET_PORT=1234
