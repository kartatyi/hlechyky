{
	# Сертифікати й стан Caddy живуть у проєкті, а не в %AppData%
	storage file_system {
		root {$HLECHYKY_ROOT}/data/caddy
	}
	log {
		output file {$HLECHYKY_ROOT}/logs/caddy.log {
			roll_size 10mb
			roll_keep 3
		}
		level INFO
	}
}

# www → без www
www.hlechyky.pp.ua {
	redir https://hlechyky.pp.ua{uri} permanent
}

hlechyky.pp.ua {
	# Потік віддає сам liquidsoap (harbor на 127.0.0.1:8001): байти одразу, без буферизації і без таймаутів на відповідь
	handle /radio.mp3 {
		reverse_proxy 127.0.0.1:8001 {
			flush_interval -1
		}
	}

	# Все інше: сайт, API, SignalR (websocket проксується сам)
	handle {
		encode zstd gzip
		reverse_proxy 127.0.0.1:8080
	}
}

# Простий http на :8000 — для ETS2 й плеєрів, що знають старе http://hlechyky.pp.ua:8000/radio.mp3 (колись там був Icecast).
# Будь-яке ім'я хоста: ETS2 може ходити й за IP. liquidsoap назовні не світиться, порт 8000 тримає Caddy.
http://:8000 {
	handle /radio.mp3 {
		reverse_proxy 127.0.0.1:8001 {
			flush_interval -1
		}
	}
	handle {
		respond "Глечики: потік — /radio.mp3" 404
	}
}
