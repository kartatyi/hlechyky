# secrets and local state
appsettings.Local.json
liquidsoap/.env
# data/ — робочі файли сайту (база, ключі, кеш). Виняток — словники: малі списки лежать у гіті,
# великий (uk-all.*) качає setup.ps1. Каталог доводиться відкривати покроково: git не заходить
# усередину проігнорованого каталогу, тому спершу data/*, потім !data/words/ і далі.
# Список файлів — поіменний, а не *.txt: у data/words/ лягають ще й вихідні корпуси на сотні
# мегабайт (dict_corp_vis.txt, freq-*.txt), і одне `git add -A` затягло б їх в історію назавжди.
data/*
!data/words/
data/words/*
!data/words/uk-5.txt
!data/words/uk-guess.txt
!data/words/uk-hangman.txt
!data/words/curation-drop.txt
!data/words/curation-keep.txt
!data/words/LICENSE.txt
!data/words/make-lists.py
# відповіді Глек-слова наввипередки на 4 і 6 літер (make-46.py)
!data/words/uk-4.txt
!data/words/uk-6.txt
!data/words/make-46.py
# Банк запитань «Скільки?» — маленький текстовий файл, який має їхати разом із грою
# (без нього гра не має в що грати). Той самий покроковий виняток, що й для словників.
!data/questions/
!data/skilky/
# Словник Піктіонарі — так само їде разом із грою.
!data/pictionary/
# Фрази-підказки Зіпсованого телефону.
!data/telephone/
# Жива реклама: підкладки, «ба-дум-тсс», банк фраз і генератор підкладок їдуть разом із сервером.
!data/liveads/
# Локації «Шпигуна» з ролями.
!data/spy/
# Банк питань «Байкарів».
!data/bluff/
# Список українських виконавців для «Вгадай мелодію».
!data/melody/
# «Своя гра»: вбудовані пакети й книга фраз ведучого їдуть разом із грою; медіа користувачів (data/svoya/media) — ні.
!data/svoya/
data/svoya/*
!data/svoya/builtin/
!data/svoya/host.json
# Рівні «Вогника і Краплі» їдуть разом із грою.
!data/vohnyk/
# «Дотепи»: банк завдань їде разом із грою.
!data/dotepy/
# «Де це?»: банк місць, README і збірник мапи.
!data/geo/
cache/
logs/
# binaries (copy yt-dlp.exe, ffmpeg.exe, ffprobe.exe into tools/yt-dlp/)
tools/
# build output
bin/
obj/
build/
# IDE and generated
.vs/
.idea/
*.user
Hlechyky.vbs

# build-dev/ — копія збірки для dev-сервера з worktree (щоб не тримати Hlechyky.dll замкненим)
build-dev/
# Клавоперегони: банк уривків класики, прислів'їв і скоромовок їде разом із грою.
!data/typerace/
# Глечикова вечірка: карти, книга фраз Глека й тексти їдуть разом із грою.
!data/vechirka/
